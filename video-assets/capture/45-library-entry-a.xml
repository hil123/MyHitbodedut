"false" long-clickable="false" password="false" selected="false" bounds="[63,267][791,417]" /><node index="2" text="Likoutei Moharan I, 52:3" resource-id="com.myhitbodedut:id/entry_reference" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[63,433][791,479]" /></node><node index="1" text="" resource-id="" class="android.widget.FrameLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[828,219][1017,450]"><node index="0" text="" resource-id="com.myhitbodedut:id/entry_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[841,232][1004,437]" /></node></node></node><node index="1" text="" resource-id="com.myhitbodedut:id/entry_paragraphs" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,569][1038,2178]"><node index="0" text="וְאִי אֶפְשָׁר לָבוֹא לִידֵי בִּטּוּל, כִּי־אִם עַל־יְדֵי הִתְבּוֹדְדוּת, כִּי עַל־יְדֵי שֶׁמִּתְבּוֹדֵד וּמְפָרֵשׁ שִׂיחָתוֹ בֵּינוֹ לְבֵין קוֹנוֹ, עַל־יְדֵי־זֶה הוּא זוֹכֶה לְבַטֵּל כָּל הַתַּאֲווֹת וְהַמִּדּוֹת רָעוֹת, עַד שֶׁזּוֹכֶה לְבַטֵּל כָּל גַּשְׁמִיּוּתוֹ, וּלְהִכָּלֵל בְּשָׁרְשׁוֹ." resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,616][991,957]" /><node index="1" text="אַךְ עִקַּר הַהִתְבּוֹדְדוּת הוּא בַּלַּיְלָה, בְּעֵת שֶׁהָעוֹלָם פָּנוּי מִטִּרְדַּת הָעוֹלָם הַזֶּה. כִּי בַּיּוֹם, עַל־יְדֵי שֶׁרוֹדְפִין הָעוֹלָם אַחַר הָעוֹלָם הַזֶּה, הוּא מְבַטֵּל וּמְבַלְבֵּל אֶת הָאָדָם מִלְּהִתְדַּבֵּק וּלְהִכָּלֵל בְּהַשֵּׁם יִתְבָּרַךְ. וַאֲפִלּוּ אִם הוּא בְּעַצְמוֹ אֵינוֹ טָרוּד, אַף־עַל־פִּי־כֵן מֵאַחַר שֶׁהָעוֹלָם טְרוּדִים אָז וְרוֹדְפִים אָז אַחַר הַבְלֵי הָעוֹלָם הַזֶּה, עַל־יְדֵי־זֶה קָשֶׁה אָז לָבוֹא לִידֵי בִּטּוּל:" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,993][991,1474]" /><node index="2" text="וְגַם צְרִיכִין שֶׁיִּהְיֶה הַהִתְבּוֹדְדוּת בְּמָקוֹם מְיֻחָד, דְּהַיְנוּ חוּץ מֵהָעִיר בְּדֶרֶךְ יְחִידִי, בְּמָקוֹם שֶׁאֵין הוֹלְכִים שָׁם בְּנֵי אָדָם, כִּי בְּמָקוֹם שֶׁהוֹלְכִים שָׁם בְּנֵי אָדָם בַּיּוֹם, הָרוֹדְפִים אַחַר הָעוֹלָם הַזֶּה, אַף־עַל־פִּי שֶׁכָּעֵת אֵינָם הוֹלְכִים שָׁם, הוּא מְבַלְבֵּל גַּם כֵּן הַהִתְבּוֹדְדוּת, וְאֵינוֹ יָכוֹל לְהִתְבַּטֵּל וּלְהִכָּלֵל בּוֹ יִתְבָּרַךְ. עַל־כֵּן צָרִיךְ שֶׁיֵּלֵךְ לְבַדּוֹ בַּלַּיְלָה, בְּדֶרֶךְ יְחִידִי, בְּמָקוֹם שֶׁאֵין שָׁם אָדָם, וְשָׁם יֵלֵךְ וְיִתְבּוֹדֵד, וִיפַנֶּה לִבּוֹ וְדַעְתּוֹ מִכָּל עִסְקֵי עוֹלָם הַזֶּה, וִיבַטֵּל הַכֹּל, עַד שֶׁיִּזְכֶּה לִבְחִינַת בִּטּוּל בֶּאֱמֶת." resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1510][991,2131]" /></node><node index="2" text="Open on Sefaria" resource-id="com.myhitbodedut:id/entry_link" class="an