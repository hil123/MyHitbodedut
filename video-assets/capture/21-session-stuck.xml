ִידַבֵּר אוֹתוֹ הַדִּבּוּר כַּמָּה וְכַמָּה פְּעָמִים בְּלִי שִׁעוּר וָעֵרֶךְ, וַאֲפִלּוּ אִם יְבַלֶּה כַּמָּה וְכַמָּה יָמִים בְּדִּבּוּר זֶה לְבַד גַּם זֶה טוֹב … עַד שֶׁיְּרַחֵם עָלָיו הַשֵּׁם יִתְבָּרַךְ, וְיִפְתַּח פִּיו, וְיוּכַל לְפָרֵשׁ שִׂיחָתוֹ." resource-id="com.myhitbodedut:id/chizuk_he" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[105,783][975,1177]" /><node index="2" text="" resource-id="" class="android.view.View" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[105,1203][975,1206]" /><node index="3" text="He said: even if one can say only a single word, let him be firm in his mind and say that word over and over, without limit or measure. Even if he spends several days on that one word alone, that too is good… until God, blessed be He, has mercy on him and opens his mouth, and he is able to pour out his words." resource-id="com.myhitbodedut:id/chizuk_translation" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[105,1232][975,1537]" /><node index="4" text="Likoutei Moharan II, 96" resource-id="com.myhitbodedut:id/chizuk_ref" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[105,1558][975,1597]" /></node><node index="5" text="I cannot find the words