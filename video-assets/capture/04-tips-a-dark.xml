llable="false" long-clickable="false" password="false" selected="false" bounds="[89,436][991,620]"><node index="0" text="1" resource-id="com.myhitbodedut:id/tip_number" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,483][178,572]" /><node index="1" text="Choose a quiet, separate place" resource-id="com.myhitbodedut:id/tip_title" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[210,471][807,585]" /><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[833,436][991,620]"><node index="0" text="" resource-id="com.myhitbodedut:id/tip_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[844,447][980,609]" /></node></node><node index="1" text="The first step in hitbodedut is to find a quiet place where you can be alone with yourself and with Hashem. It does not have to be entirely isolated, but it must be somewhere you will not be interrupted. A free room at home, a quiet stretch of beach, a spot out in nature. If you can, choose a natural setting: nature itself can be a source of inner quiet." resource-id="com.myhitbodedut:id/tip_body" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,652][991,1029]" /></node><node index="1" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1108][1038,1795]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1155][991,1339]"><node index="0" text="2" resource-id="com.myhitbodedut:id/tip_number" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1202][178,1291]" /><node index="1" text="Set a daily or weekly time" resource-id="com.myhitbodedut:id/tip_title" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[210,1216][807,1277]" /><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[833,1155][991,1339]"><node index="0" text="" resource-id="com.myhitbodedut:id/tip_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[844,1166][980,1328]" /></node></node><node index="1" text="If you are new to this, start short. Give fifteen minutes a day to hitbodedut, and lengthen it gradually until you reach a full hour. Do not jump straight to a long session. Go step by step, so that it becomes a habit and not a burden. Fix a regular time, so the practice becomes part of your routine rather than something random." resource-id="com.myhitbodedut:id/tip_body" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1371][991,1748]" /></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1827][1038,2337]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1874][991,2058]"><node index="0" text="3" resource-id="com.myhitbodedut:id/tip_number" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1921][178,2010]" /><node index="1" text="Begin with inner speech" resource-id="com.myhitbodedut:id/tip_title" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[210,1935][807,1996]" /><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[833,1874][991,2058]"><node index="0" text="" resource-id="com.myhitbodedut:id/tip_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[844,1885][980,2047]" /></node></node><node index="1" text="Begin the hitbodedut with inner speech, talk with Hashem. Do not worry if at first you do not know quite what to say. Simply open your heart and begin. It can be asking forgiveness, a plain prayer about what you feel, or even a sense of gratitude. Hitbodedut does not have to be orderly or planned in advance. It is a place to release what is in your heart and to turn towards the bond with Hashem." resource-id="com.myhitbodedut:id/tip_body" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,2090][991,2337]" /></node></node></node></node></node></node></node><node index="1" text="" resource-id="android:id/statusBarBackground" class="android.view.View" package="com.myhitbodedut" content-desc="" checkable="false