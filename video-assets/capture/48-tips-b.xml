alse" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[833,856][991,1040]"><node index="0" text="" resource-id="com.myhitbodedut:id/tip_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[844,867][980,1029]" /></node></node><node index="1" text="Begin the hitbodedut with inner speech, talk with Hashem. Do not worry if at first you do not know quite what to say. Simply open your heart and begin. It can be asking forgiveness, a plain prayer about what you feel, or even a sense of gratitude. Hitbodedut does not have to be orderly or planned in advance. It is a place to release what is in your heart and to turn towards the bond with Hashem." resource-id="com.myhitbodedut:id/tip_body" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1072][991,1503]" /></node><node index="2" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,1582][1038,2269]"><node index="0" text="" resource-id="" class="android.widget.LinearLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1629][991,1813]"><node index="0" text="4" resource-id="com.myhitbodedut:id/tip_number" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[89,1676][178,1765]" /><node index="1" text="Put the devices away" resource-id="com.myhitbodedut:id/tip_title" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[210,1690][807,1751]" /><node index="2" text="" resource-id="" class="android.widget.FrameLayout" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[833,1629][991,1813]"><node index="0" text="" resource-id="com.myhitbodedut:id/tip_art" class="android.widget.ImageView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[844,1640][980,1802]" /></node></node><node index="1" text="If you want to feel truly alone with yourself, avoid devices entirely during hitbodedut. Turn the phone off, or leave it in another room. The freer you are of outside distraction, the better you will connect to yourself and to the Creator. Cutting off from the outside world helps you concentrate and settle into the quiet within." resource-id="com.myhitbodedut:id/tip_body" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[