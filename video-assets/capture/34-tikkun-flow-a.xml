long-clickable="false" password="false" selected="false" bounds="[52,997][1028,1061]" /><node index="3" text="נְקַדְּמָה פָנָיו בְּתוֹדָה בִּזְמִרוֹת נָרִיעַ לוֹ:" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1082][1028,1146]" /><node index="4" text="כִּי אֵל גָּדוֹל ה' וּמֶלֶךְ גָּדוֹל עַל כָּל אֱלֹקִים:" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1167][1028,1231]" /><node index="5" text="הריני מזמן את פי להודות וּלְהלל וּלְשבח את בוראי. לְשֵם יִחוּד קוּדְשָא בְּרִיךְ הוּא וּשְכִינְתֵּהּ בִּדְחִילוּ וּרְחִימוּ על ידי ההוא טמיר ונעלם בשם כל ישראל." resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1252][1028,1474]" /><node index="6" text="תהילים 16" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1542][1028,1613]" /><node index="7" text="מִכְתָּם לְדָוִד שָׁמְרֵנִי אֵל כִּי־חָסִיתִי בָךְ׃" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1649][1028,1716]" /><node index="8" text="אָמַרְתְּ לַה' אֲדֹ-נָי אָתָּה טוֹבָתִי בַּל־עָלֶיךָ׃" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1737][1028,1804]" /><node index="9" text="לִקְדוֹשִׁים אֲשֶׁר־בָּאָרֶץ הֵמָּה וְאַדִּירֵי כָּל־חֶפְצִי־בָם׃" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1825][1028,1892]" /><node index="10" text="יִרְבּוּ עַצְּבוֹתָם אַחֵר מָהָרוּ בַּל־אַסִּיךְ נִסְכֵּיהֶם מִדָּם וּבַל־אֶשָּׂא אֶת־שְׁמוֹתָם עַל־שְׂפָתָי׃" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,1913][1028,2061]" /><node index="11" text="ה' מְנָת־חֶלְקִי וְכוֹסִי אַתָּה תּוֹמִיךְ גּוֹרָלִי׃" resource-id="" class="android.widget.TextView" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[52,2082][1028,2144]" /></node></node><node index="2" text="I have said the whole Tikkun" resource-id="com.myhitbodedut:id/flow_done" class="android.widget.Button" package="com.myhitbodedut" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[42,2144][1038,2295]" /></node