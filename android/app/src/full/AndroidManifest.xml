<?xml version="1.0" encoding="utf-8"?>
<!--
    Ce que l'édition complète ajoute : la barrière du matin, et les deux accès
    spéciaux qu'elle exige ; l'accès Internet du suivi de vol en direct (28/10),
    utilisé seulement si l'on active l'option (SuiviVol). Ils sont volontairement
    absents de l'édition légère.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Le suivi de vol en direct, désactivé par défaut : HTTPS vers le relais seulement. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Visibilité des applications lançables, pour que l'utilisateur puisse les
        choisir dans la liste. On évite volontairement QUERY_ALL_PACKAGES, dont
        Google Play restreint l'usage à une courte liste de cas approuvés.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="false">

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:label="@string/apps_title" />

        <service
            android:name=".GateService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FOREGROUND_SERVICE_SUBTYPE"
                android:value="Interposes a confirmation screen over user-selected apps during a user-defined morning window, until the user confirms their daily practice." />
        </service>
    </application>
</manifest>
