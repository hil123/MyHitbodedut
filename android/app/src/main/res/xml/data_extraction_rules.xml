<?xml version="1.0" encoding="utf-8"?>
<!--
    Dans le nuage, les réglages seuls : le journal et les notes ne quittent
    pas le téléphone pour un serveur. Ce qui n'est pas inclus est écarté.

    Le transfert d'appareil, lui, va directement de l'ancien téléphone au
    nouveau, par câble ou en local, sans passer par un serveur. Le journal y
    est inclus : l'en exclure faisait perdre tout l'historique à chaque
    changement de téléphone, faute d'avoir pensé à l'export (revue du 29/09).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="myhitbodedut.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="myhitbodedut.xml" />
        <include domain="sharedpref" path="myhitbodedut-journal.xml" />
    </device-transfer>
</data-extraction-rules>
