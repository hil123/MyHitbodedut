<?xml version="1.0" encoding="utf-8"?>
<!--
    Les couleurs du jour. Celles de la nuit sont dans values-night, et ne
    reprennent que ce qui doit changer.

    Trois jetons ne changent jamais, et c'est voulu :

    « stage_soft » et « mint » servent de plaque sous les illustrations, qui
    sont dessinées sur fond blanc. Une plaque sombre leur mettrait un halo
    blanc autour : la plaque reste claire la nuit.

    « on_plate » est l'encre posée sur ces plaques claires. Elle ne peut pas
    suivre « brand », qui s'éclaircit la nuit pour se lire sur une carte
    sombre : vert clair sur menthe claire ne se lit plus.

    « white » est l'encre posée sur les fonds vert foncé, qui sont déjà
    sombres le jour. La renverser la nuit effacerait le décompte de séance.
-->
<resources>
    <color name="brand">#16775A</color>
    <color name="brand_dark">#173C32</color>
    <color name="mint">#DFF5E8</color>
    <color name="warning">#A8561F</color>
    <color name="ink">#172B27</color>
    <color name="muted">#5E706A</color>
    <color name="paper">#F4F7F2</color>
    <color name="card">#FFFFFF</color>
    <color name="line">#DCE7DF</color>
    <color name="white">#FFFFFF</color>

    <!-- Encre du bouton principal, qui se renverse la nuit. -->
    <color name="on_brand">#FFFFFF</color>

    <!-- Encre sur les plaques claires, qui ne se renverse jamais. -->
    <color name="on_plate">#16775A</color>

    <!-- Plaque claire sous une illustration. Claire de nuit comme de jour. -->
    <color name="stage_soft">#F1FAF4</color>

    <!-- Les trois états d'une case de la bande hebdomadaire. -->
    <color name="day_done">#16775A</color>
    <color name="day_todo">#EDF2EE</color>
    <color name="day_exempt">#F3EEE2</color>

    <!-- Les anneaux de l'accueil : le jour prend la couleur de marque,
         la semaine et la série ont les leurs, fixes de jour et de nuit. -->
    <color name="ring_week">#2E7DB3</color>
    <color name="ring_streak">#B8780F</color>
    <!-- Les mêmes, sur le fond vert foncé de la vignette : plus clairs, et fixes. -->
    <color name="ring_week_on_dark">#8CCBF2</color>
    <color name="ring_streak_on_dark">#F0C46A</color>
    <!-- Fond très dilué du badge d'avertissement. -->
    <color name="warning_wash">#1FC66B2D</color>
    <!-- La lecture des textes saints (ReglagesLecture) : le bouton discret, et le fond noir. -->
    <color name="lecture_bouton">#D96A9BD1</color>
    <color name="lecture_nuit_fond">#000000</color>
    <color name="lecture_nuit_texte">#F2F0EA</color>
    <color name="lecture_nuit_discret">#A3A8A5</color>
    <color name="lecture_nuit_titre">#D6C28C</color>
</resources>
