<?xml version="1.0" encoding="utf-8"?>
<!--
    L'echelle horizontale des ecrans.

    Deux jetons, declines par LARGEUR DISPONIBLE (« w ») et non par largeur
    d'appareil (« sw »). La difference compte : sur ChromeOS, en fenetre
    partagee ou sur un bureau, la fenetre se redimensionne et « sw » ne
    bouge pas, alors que « w » suit.

    « edge » est la marge que chaque ecran laisse sur ses cotes. La valeur
    par defaut vise 320dp de large — c'est la plus petite largeur
    qu'Android connaisse, celle d'un ecran 480x854 en hdpi, et tout doit y
    tenir. Les 26dp d'avant n'y laissaient que 268dp de contenu.

    « wide_gutter » sert au seul ecran principal, dont les cartes portent
    deja leur propre marge : il reste nul sur telephone et n'ajoute de
    l'air que la ou l'ecran devient trop large pour qu'une ligne de texte
    reste lisible d'un bord a l'autre.
-->
<resources>
    <dimen name="edge">16dp</dimen>
    <dimen name="wide_gutter">0dp</dimen>
    <!--
        « edge_inner » : la marge d'un texte posé DANS l'air des grands écrans
        (wide_gutter). Les deux s'ajoutent : edge_inner = edge - wide_gutter,
        pour que le texte s'aligne sur les cartes (16dp de marge propre). Y
        mettre « edge » doublait la marge : sur une tablette couchée de
        1280dp, il ne restait que 32dp, et l'accueil s'affichait vide.
    -->
    <dimen name="edge_inner">16dp</dimen>

    <!--
        Les hauteurs fixes, elles, se declinent par hauteur disponible (« h »).
        Le defaut vise l'ecran COURT : en paysage sur un 480x854, il ne reste
        que 320dp de haut, et une illustration de 190dp en mangeait 60 %.
        values-h480dp rend les valeurs confortables des qu'il y a la place.

        Elles restent FIXES dans chaque palier, et c'est voulu : les deux
        blocs de la carte de 'hizouk reduisent leur corps jusqu'a tenir
        (autoSizeTextType) au lieu de deborder. Une hauteur libre y
        ramenerait le defilement que le point 4 interdit.
    -->
    <dimen name="art_height">130dp</dimen>
    <dimen name="art_height_small">88dp</dimen>
    <dimen name="chizuk_he_height">108dp</dimen>
    <dimen name="chizuk_body_height">84dp</dimen>

    <!--
        La presentation du premier lancement. Le defaut vise l'ecran court
        (480x854 debout : environ 500dp utiles) : titre, texte et « Suivant »
        doivent s'y voir sans defiler, l'illustration prenant ce qui reste.
        values-h640dp rend l'air des que la hauteur le permet.
    -->
    <dimen name="onboarding_pad_v">14dp</dimen>
    <dimen name="onboarding_art_min">96dp</dimen>
    <dimen name="onboarding_art_gap">12dp</dimen>
    <dimen name="onboarding_title_gap">14dp</dimen>
    <dimen name="onboarding_title_size">19sp</dimen>
    <dimen name="onboarding_body_gap">6dp</dimen>
    <dimen name="onboarding_next_gap">12dp</dimen>
    <dimen name="onboarding_next_pad">10dp</dimen>

    <!--
        La jauge de l'accueil et le hassid en son creux. Le défaut vise
        l'écran court : debout sur un 480x854, il reste environ 420dp entre
        la barre d'état et les onglets, et à 236dp la jauge repoussait
        « Commencer » sous les onglets dès que le titre prenait deux lignes.
        values-h640dp rend 236dp, values-h720dp 268dp. 15/10 : 168dp coupaient encore
        « Commencer » sous les onglets (capture 480x854) ; 136dp le laissent entier.
    -->
    <dimen name="gauge_size">136dp</dimen>
    <!--
        La même jauge, posée à côté de l'en-tête (layout-land/activity_main.xml).
        Couché sur un 480x854, il reste 216dp sous la barre d'état et au-dessus
        des onglets : 168dp y laissent la légende.
    -->
    <dimen name="gauge_size_side">168dp</dimen>
    <!-- L'en-tête des écrans (12/10) : plus bas sur un petit téléphone, tel qu'avant à partir de 640dp de haut. -->
    <dimen name="hero_pad_top">12dp</dimen>
    <dimen name="hero_pad_bottom">10dp</dimen>
    <dimen name="hero_art_w">50dp</dimen>
    <dimen name="hero_art_h">60dp</dimen>
    <dimen name="hero_title">21sp</dimen>
    <!-- Les intitulés des onglets : sur 320dp, cinq onglets de 64dp coupaient « Aujourd'hui » et « Bibliothèque » (15/10). -->
    <dimen name="nav_label">10sp</dimen>
</resources>
