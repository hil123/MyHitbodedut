<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        La base du thème, redéfinie dans values-v35 pour Android 15 : les
        écrans y seraient dessinés sous la barre d'état et la barre de gestes,
        et la couleur de barre d'état ci-dessous ignorée (revue du 29/09).
    -->
    <style name="Base.Theme.MyHitbodedut" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.MyHitbodedut" parent="Base.Theme.MyHitbodedut">
        <!-- Le personnage au féminin pour qui a choisi צדקת (audit 1.390) : voir Personnage.kt. -->
        <item name="viewInflaterClass">com.myhitbodedut.PersonnageViewInflater</item>
        <!-- Le passage d'un écran à l'autre (19/10, effets) : glissement court et fondu. -->
        <item name="android:windowAnimationStyle">@style/Effets.Fenetres</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorSecondary">@color/brand_dark</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Les surfaces Material (dialogues, interrupteurs) aux couleurs
             d'origine, comme les autres fonds les définissent : sans elles,
             le choix du nusah s'ouvrait sur le lavande de Material 3. -->
        <item name="colorSurface">@color/card</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorPrimaryContainer">@color/mint</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <!-- Les couleurs réglables (values/attrs.xml), à leur valeur d'origine. -->
        <item name="mhBrandDark">@color/brand_dark</item>
        <item name="mhBrand">@color/brand</item>
        <item name="mhMint">@color/mint</item>
        <item name="mhOnBrand">@color/on_brand</item>
        <item name="mhOnPlate">@color/on_plate</item>
        <item name="mhStageSoft">@color/stage_soft</item>
        <item name="mhDayDone">@color/day_done</item>
        <item name="mhPaper">@color/paper</item>
        <item name="mhCard">@color/card</item>
        <item name="mhLine">@color/line</item>
        <item name="mhInk">@color/ink</item>
        <item name="mhMuted">@color/muted</item>
        <item name="mhDayTodo">@color/day_todo</item>
    </style>

    <!-- Carte blanche arrondie, l'unité de base des écrans. -->
    <style name="Effets.Fenetres" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/effet_ouvre_entre</item>
        <item name="android:activityOpenExitAnimation">@anim/effet_reste</item>
        <item name="android:activityCloseEnterAnimation">@anim/effet_reste</item>
        <item name="android:activityCloseExitAnimation">@anim/effet_ferme_sort</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/mhInk</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CardHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">?attr/mhMuted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Ligne de réglage : libellé à gauche, valeur cliquable à droite. -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/mhInk</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        Variante pour un libellé placé dans une colonne verticale.
        SettingLabel ne convient pas là : sa largeur nulle le rend invisible et
        son poids lui fait avaler toute la hauteur disponible.
    -->
    <style name="SettingLabelStacked">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/mhInk</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingValue" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">88dp</item>
    </style>

    <!--
        Les quatre boutons de duree, cote a cote.

        Un bouton Material3 reclame 88dp de large, dont 48 de rembourrage.
        Quatre y tiennent sur un ecran large ; sur 320dp il ne reste que 67dp
        par bouton, et « 20 min » se faisait couper. Le rembourrage tombe donc
        a 4dp et le texte a 13sp : il reste 59dp pour une etiquette qui en
        demande 40.
    -->
    <style name="DurationButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/mhMint</item>
    </style>

    <!--
        Une entrée de section sur l'écran principal : un titre, son état, et
        toute la ligne cliquable. Elle remplace une carte entière par ligne —
        six cartes prenaient environ 970dp de haut, six lignes en prennent
        490, soit un écran de moins à faire défiler avant d'atteindre quoi
        que ce soit.
    -->
    <style name="SectionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical">10dp</item>
    </style>

    <!--
        Une ligne de la carte de départ : un libellé à gauche, sa valeur à
        droite, toute la ligne cliquable. Plus serrée qu'une ligne de
        section — ce sont quatre réglages d'une même séance, pas quatre
        destinations.
    -->
    <style name="StartRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="StartLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/mhMuted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="StartValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:textColor">?attr/mhBrand</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Un réglage de la prochaine séance, en pastille sous le bouton de
        l'accueil (demande du 28/09, pistes A + D) : le libellé en gris, la
        valeur en couleur, toute la pastille cliquable.
    -->
    <style name="StartChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_start_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">14dp</item>
    </style>

    <style name="StartChipLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/mhMuted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="StartChipValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:maxWidth">160dp</item>
        <item name="android:textColor">?attr/mhBrand</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- La pastille derrière l’onglet actif. mhLine plutôt que mhMint : la menthe reste claire la nuit, et l’icône active, éclaircie la nuit, n’y serait plus lisible. -->
    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/nav_label</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/mhLine</item>
    </style>

    <style name="SectionChevron">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:src">@drawable/ic_chevron</item>
    </style>

    <style name="SectionState" parent="CardHint">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginVertical">14dp</item>
        <item name="android:background">?attr/mhLine</item>
    </style>


    <!-- L'écran d'ouverture (15/10) : un fond sombre le temps du premier dessin, puis
         le 'hassid devant le tziyoun une seconde et demie (MainActivity.ouverture). -->
    <style name="Theme.MyHitbodedut.Ouverture" parent="Theme.MyHitbodedut">
        <item name="android:windowBackground">@drawable/fond_ouverture</item>
    </style>
</resources>
