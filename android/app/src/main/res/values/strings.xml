    <!-- Présentation détaillée, bravo de fin de séance, apparence (28/09). -->
    <string name="onboarding_session">La séance</string>
    <string name="onboarding_session_body">Choisissez une durée, ou une séance sans durée, et un sujet si vous voulez. Un nigoun peut vous accompagner. Un mot de ’hizouk ouvre et clôt la séance, et si les mots ne viennent pas, un bouton est là pour vous aider.</string>
    <string name="onboarding_days">Jour après jour</string>
    <string name="onboarding_days_body">La série compte les jours de pratique d’affilée, et la semaine se lit d’un coup d’œil. Après chaque séance, une note peut rejoindre votre journal. Des rappels vous font signe à l’heure que vous choisissez.</string>
    <string name="onboarding_texts">Des textes pour prier</string>
    <string name="onboarding_texts_body">Le Tikoun HaKlali, les Tfilot classées par sujet, une bibliothèque et des conseils pour la hitbodedout, à ouvrir quand vous voulez.</string>
    <string name="onboarding_yours">À votre façon</string>
    <string name="onboarding_yours_body">Dans les réglages : la langue (français, anglais ou hébreu), les couleurs de l’écran, votre prénom et la durée habituelle d’une séance. La musique a sa propre section.</string>
    <string name="onboarding_adresse">Comment vous appeler ?</string>
    <string name="onboarding_adresse_body">À la fin de chaque séance, l’application vous félicite. Choisissez le mot qui vous convient ; vous pourrez le changer dans les réglages.</string>
