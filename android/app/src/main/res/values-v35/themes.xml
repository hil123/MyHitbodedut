<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 15 dessine toute application qui le vise (targetSdk 35) sous
        les barres du système. Aucun écran ne gère encore ces marges : les
        titres passaient sous la barre d'état et les boutons du bas sous la
        barre de gestes. Ce réglage garde l'affichage d'avant, le temps de
        les traiter écran par écran ; il cessera d'agir quand l'application
        visera Android 16 (targetSdk 36).
    -->
    <style name="Base.Theme.MyHitbodedut" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
