<?xml version="1.0" encoding="utf-8"?>
<!--
    Une fiche de relecture : tout ce qu'il faut pour comparer à la source,
    sans quitter le téléphone. Rien n'est tronqué ni rétréci ici — c'est
    l'inverse de la carte de 'hizouk, qui doit tenir d'un regard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/proofread_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="?attr/mhOnPlate"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/proofread_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_warning"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="@color/warning"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/proofread_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/mhMuted"
        android:textSize="11sp"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/proofread_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="?attr/mhInk"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/proofread_he"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layoutDirection="rtl"
        android:lineSpacingExtra="4sp"
        android:textAlignment="viewStart"
        android:textColor="?attr/mhInk"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/proofread_fr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2sp"
        android:textColor="?attr/mhMuted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/proofread_en"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2sp"
        android:textColor="?attr/mhMuted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/proofread_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="?attr/mhMuted"
        android:textSize="11sp" />

    <Button
        android:id="@+id/proofread_source"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/proofread_open_source"
        android:textSize="13sp" />
</LinearLayout>
