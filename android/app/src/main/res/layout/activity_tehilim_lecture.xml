<?xml version="1.0" encoding="utf-8"?>
<!--
    La lecture de Tehilim : un psaume, ou la portion du jour d'un seul
    trait. Pour un psaume seul, deux boutons mènent au précédent et au
    suivant ; pour une portion, rien n'interrompt la lecture.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="@dimen/hero_pad_top"
        android:paddingBottom="@dimen/hero_pad_bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lecture_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tehilim_title"
                android:textColor="@color/white"
                android:textSize="@dimen/hero_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lecture_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/mhMint"
                android:textSize="14sp" />
        </LinearLayout>
        <!-- Pas d'image pendant une prière (demande du 13/10). -->
    </LinearLayout>

    <!-- Le texte ; le bouton de lecture (ReglagesLecture) se pose par-dessus tout l'écran. -->
    <FrameLayout
        android:id="@+id/lecture_cadre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/lecture_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/lecture_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="88dp" />
    </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/lecture_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/lecture_previous"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/tehilim_previous" />

        <Button
            android:id="@+id/lecture_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/tehilim_next" />
    </LinearLayout>
</LinearLayout>
