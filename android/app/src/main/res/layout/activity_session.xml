<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/session_fond"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhBrandDark"
    android:fillViewport="true">

    <!-- La lueur de la pratique (16/10) couvre tout, derrière le contenu (SouffleView). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.myhitbodedut.SouffleView
            android:id="@+id/session_souffle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minHeight="400dp"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edge"
            android:paddingTop="24dp"
            android:paddingBottom="104dp">

            <TextView
                android:id="@+id/session_titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/session_screen_title"
                android:textColor="?attr/mhMint"
                android:textSize="13sp" />

            <FrameLayout
                android:id="@+id/session_scene"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_stage"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/session_character"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/art_height"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/session_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/white"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/session_caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:textColor="?attr/mhMint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/session_music"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                android:textColor="?attr/mhMint"
                android:textSize="13sp"
                android:visibility="gone" />

            <!--
                Le bouton principal juste sous le minuteur (demande du 11/10) :
                « Commencer » ou « Terminer » se voit sans défiler, même sur un
                480x854. Le sujet et les durées suivent, le mot de 'hizouk en
                dernier.
            -->
            <Button
                android:id="@+id/session_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingVertical="12dp"
                android:textSize="16sp" />

            <Button
                android:id="@+id/session_secondary"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/mhMint" />

            <!--
                Le sujet de la séance. Facultatif : « Aucun » est la valeur de
                départ et une réponse recevable — on vient souvent sans savoir
                de quoi on va parler.
            -->
            <Button
                android:id="@+id/session_theme"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="?attr/mhMint" />

            <!--
                Les durées proposées (demande du 28/09) : 5, 10, 15, 30 min,
                1 h, 1 h 30, en deux rangées de trois, puis la durée réglable.
            -->
            <LinearLayout
                android:id="@+id/session_durations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/duration_5"
                        style="@style/DurationButton"
                        android:tag="5" />

                    <Button
                        android:id="@+id/duration_10"
                        style="@style/DurationButton"
                        android:layout_marginStart="4dp"
                        android:tag="10" />

                    <Button
                        android:id="@+id/duration_15"
                        style="@style/DurationButton"
                        android:layout_marginStart="4dp"
                        android:tag="15" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/duration_30"
                        style="@style/DurationButton"
                        android:tag="30" />

                    <Button
                        android:id="@+id/duration_60"
                        style="@style/DurationButton"
                        android:layout_marginStart="4dp"
                        android:tag="60" />

                    <Button
                        android:id="@+id/duration_90"
                        style="@style/DurationButton"
                        android:layout_marginStart="4dp"
                        android:tag="90" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/session_custom"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/duration_custom"
                android:textColor="?attr/mhMint" />

            <!-- La séance sans durée : on s'arrête quand on s'arrête. -->
            <Button
                android:id="@+id/session_open"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/session_open"
                android:textColor="?attr/mhMint" />

            <!-- « Commencer simplement » (proposition 15, 19/10) : quatre façons d'entrer, qui démarrent tout de suite. -->
            <LinearLayout
                android:id="@+id/session_simplement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/simplement_parler"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/simplement_parler"
                    android:textColor="?attr/mhMint" />

                <Button
                    android:id="@+id/simplement_ecrire"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/simplement_ecrire"
                    android:textColor="?attr/mhMint" />

                <Button
                    android:id="@+id/simplement_prier"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/simplement_prier"
                    android:textColor="?attr/mhMint" />

                <Button
                    android:id="@+id/simplement_question"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/simplement_question"
                    android:textColor="?attr/mhMint" />
            </LinearLayout>

            <!-- Point 4 : ouverture au début de la séance, blocage pendant. -->
            <include
                android:id="@+id/session_chizuk"
                layout="@layout/view_chizuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <!-- La hitbodedout guidée, quand elle est demandée. -->
            <include
                android:id="@+id/session_hitbodedut"
                layout="@layout/view_hitbodedut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/session_stuck"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/chizuk_stuck"
                android:textColor="?attr/mhMint"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="999dp"
                app:strokeColor="@color/contour_menthe"
                app:strokeWidth="1dp" />

            <!-- « Je ne sais pas quoi dire » (propositions 3 et 15, 19/10) : une question à la fois.
                 Carte sobre : rang espacé, jauge fine, question, pastille fléchée. -->
            <LinearLayout
                android:id="@+id/session_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_question_carte"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/session_question_rang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:letterSpacing="0.12"
                    android:textColor="?attr/mhMint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/session_question_jauge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="?attr/mhMint"
                    app:trackColor="#1FFFFFFF"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="2dp" />

                <TextView
                    android:id="@+id/session_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/session_question_suivante"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:minHeight="44dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/question_suivante"
                    android:textColor="?attr/mhMint"
                    android:textSize="14sp"
                    app:cornerRadius="999dp"
                    app:icon="@drawable/ic_fleche_suivante"
                    app:iconGravity="textEnd"
                    app:iconPadding="4dp"
                    app:iconSize="18dp"
                    app:iconTint="?attr/mhMint"
                    app:strokeColor="@color/contour_menthe"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</ScrollView>
