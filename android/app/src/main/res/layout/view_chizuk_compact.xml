<?xml version="1.0" encoding="utf-8"?>
<!--
    La même carte que view_chizuk.xml, en plus court.

    L'écran de porte s'ouvre sur quelqu'un qui vient d'attraper son téléphone :
    il doit tenir d'un regard, sans faire défiler. Les données ne proposent à ce
    moment que des textes de 15 s de lecture ou moins (voir ChizukRulesTest),
    des hauteurs plus basses suffisent donc.

    Les identifiants sont les mêmes, ChizukCard remplit les deux sans savoir
    laquelle il a reçue.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <!-- L'illustration et le nom du moment : la carte dit d'abord où l'on est. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_stage_soft"
            android:padding="4dp">

            <ImageView
                android:id="@+id/chizuk_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chizuk_moment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/mhBrand"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chizuk_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_badge_warning"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="@string/chizuk_badge_to_proofread"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/chizuk_he"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:layoutDirection="rtl"
        android:lineSpacingExtra="2sp"
        android:textAlignment="viewStart"
        android:textColor="?attr/mhInk" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="10dp"
        android:background="?attr/mhLine" />

    <TextView
        android:id="@+id/chizuk_translation"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="8sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:lineSpacingExtra="2sp"
        android:textColor="?attr/mhMuted" />

    <TextView
        android:id="@+id/chizuk_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/mhMuted"
        android:textSize="11sp" />
</LinearLayout>
