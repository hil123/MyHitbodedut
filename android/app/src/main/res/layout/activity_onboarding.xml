<?xml version="1.0" encoding="utf-8"?>
<!--
    Le défilement n'est pas décoratif. En paysage sur un écran 480×854,
    la hauteur tombe à 320dp alors que les parties fixes de cet accueil en
    demandent environ 330 : sans lui, les boutons du bas sortaient du cadre
    et il n'y avait plus moyen de passer l'accueil.

    fillViewport étire la page quand la place est suffisante, pour que
    l'illustration occupe le vide au lieu de laisser un blanc en bas. Et
    l'illustration garde une hauteur minimale : avec le seul poids, elle se
    réduirait à rien dès que la place manque, au lieu de faire défiler.

    L'illustration est une IllustrationSouple : une ImageView ordinaire
    annonçait la hauteur de son dessin à la première mesure, plus haute que
    l'écran, et repoussait titre, texte et boutons sous le bord. Les
    espacements suivent la hauteur (values/dimens.xml, values-h640dp).
    Couché, l'écran a sa propre disposition (layout-land).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/edge"
        android:paddingVertical="@dimen/onboarding_pad_v">

        <TextView
            android:id="@+id/onboarding_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_mint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textColor="?attr/mhOnPlate"
            android:textSize="12sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/onboarding_art_gap"
            android:layout_weight="1"
            android:background="@drawable/bg_stage"
            android:minHeight="@dimen/onboarding_art_min"
            android:padding="12dp">

            <com.myhitbodedut.IllustrationSouple
                android:id="@+id/onboarding_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_title_gap"
            android:textColor="?attr/mhInk"
            android:textSize="@dimen/onboarding_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/onboarding_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_body_gap"
            android:lineSpacingExtra="3sp"
            android:textColor="?attr/mhMuted"
            android:textSize="15sp" />

        <!-- Seulement sur l'écran « comment vous appeler ». Choisir est facultatif. -->
        <LinearLayout
            android:id="@+id/onboarding_adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/onboarding_tsadik"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/adresse_tsadik" />

            <Button
                android:id="@+id/onboarding_tsadeket"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checkable="true"
                android:text="@string/adresse_tsadeket" />
        </LinearLayout>

        <!-- Seulement sur l'écran de la pratique : la durée habituelle (16/10). -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/onboarding_durees"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/onboarding_duree_0"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/onboarding_duree_1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/onboarding_duree_2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/onboarding_duree_3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Seulement sur l'écran « jour après jour » : le rappel quotidien, facultatif (16/10). -->
        <LinearLayout
            android:id="@+id/onboarding_rappel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/onboarding_rappel_switch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/onboarding_rappel"
                android:textColor="?attr/mhInk"
                android:textSize="15sp" />

            <Button
                android:id="@+id/onboarding_rappel_heure"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/onboarding_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_next_gap"
            android:paddingVertical="@dimen/onboarding_next_pad"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/onboarding_back"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/onboarding_skip"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_skip" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
