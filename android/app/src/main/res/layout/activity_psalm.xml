<?xml version="1.0" encoding="utf-8"?>
<!--
    Un psaume en entier.

    L'ecran defile : le psaume 105 fait quarante-cinq versets, les faire
    tenir sur une page les rendrait illisibles. Les versets sont ajoutes
    dans psalm_verses par PsalmActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:tag="bandeau"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="@dimen/hero_pad_top"
        android:paddingBottom="@dimen/hero_pad_bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/psalm_heading"
                android:fontFamily="@font/hebreu_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutDirection="rtl"
                android:textAlignment="viewStart"
                android:textColor="@color/white"
                android:textSize="@dimen/hero_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/psalm_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/mhMint"
                android:textSize="13sp" />
        </LinearLayout>
        <!-- Pas d'image pendant une prière (demande du 13/10). -->
    </LinearLayout>

    <ScrollView
        android:id="@+id/psalm_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/psalm_verses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/psalm_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/psalm_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="13dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/psalm_next"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:paddingVertical="13dp"
            android:text="@string/tikkun_next"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
