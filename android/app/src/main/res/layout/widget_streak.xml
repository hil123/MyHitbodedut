<?xml version="1.0" encoding="utf-8"?>
<!--
    La vignette à sa taille habituelle : à un bout, les anneaux de l'accueil
    avec le hassid en leur creux ; à l'autre, la salutation de l'heure et la
    série, les minutes du jour en grands chiffres (ou le temps en direct
    pendant une hitbodedout), la semaine en toutes lettres, et le bouton.

    Le fond et les anneaux sont des images dessinées par le code
    (StreakWidget.fond, StreakWidget.jauge) : RemoteViews n'accepte pas de
    vue sur mesure, et avant Android 12 ne teint pas un fond de vue. Les
    images et les chiffres posés ici ne servent qu'à l'aperçu du sélecteur
    de vignettes, qui la dessine sans le code.

    « @android:id/background » : le lanceur d'Android 12 et plus y reconnaît
    le fond, et en arrondit les coins comme ceux des autres vignettes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_fond"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_widget" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_gauge"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/widget_apercu_anneaux" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="3"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <!-- La salutation de l'heure, ou l'état du jour ; la série dans sa pastille. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_greeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/widget_todo"
                            android:textColor="@color/mint"
                            android:textSize="12sp" />

                        <FrameLayout
                            android:id="@+id/widget_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp">

                            <ImageView
                                android:id="@+id/widget_badge_fond"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitXY"
                                android:src="@drawable/bg_widget_voile" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="0dp">

                                <ImageView
                                    android:id="@+id/widget_flame"
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_widget_flame" />

                                <TextView
                                    android:id="@+id/widget_streak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/widget_apercu_serie"
                                    android:textColor="@color/white"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Les minutes du jour sur l'objectif, en grands chiffres. -->
                    <TextView
                        android:id="@+id/widget_minutes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1"
                        android:text="@string/widget_apercu_minutes"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <!-- Pendant la hitbodedout : le temps qui reste, ou qui passe sans durée fixée. -->
                    <Chronometer
                        android:id="@+id/widget_chrono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/widget_week_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/mint"
                        android:textSize="12sp" />

                    <!-- Le bouton : une pastille claire, teinte par le code à la palette choisie. -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/widget_start_fond"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitXY"
                            android:src="@drawable/bg_widget_button" />

                        <TextView
                            android:id="@+id/widget_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:maxLines="1"
                            android:minWidth="88dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="@string/widget_start"
                            android:textColor="@color/on_plate"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
