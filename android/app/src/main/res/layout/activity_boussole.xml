<?xml version="1.0" encoding="utf-8"?>
<!-- La boussole de Jérusalem (28/10, design C) : le lieu, la boussole du hassid, les deux directions ; construite par BoussoleActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:tag="bandeau"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="@dimen/hero_pad_top"
        android:paddingBottom="@dimen/hero_pad_bottom">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/boussole_title"
                android:textColor="@color/white"
                android:textSize="@dimen/hero_title"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/boussole_lieu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_hero_chip"
                android:gravity="center_vertical"
                android:minHeight="36dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/zmanim_choisir_lieu"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="@dimen/hero_art_w"
            android:layout_height="@dimen/hero_art_h"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_stage"
            android:padding="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/char_standing_back" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/boussole_defile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/wide_gutter">

        <LinearLayout
            android:id="@+id/boussole_contenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
