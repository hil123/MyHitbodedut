<?xml version="1.0" encoding="utf-8"?>
<!-- La lecture d'un texte du siddour : une liste recyclée (SiddurLectureActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <!--
        La bannière d'une prière (16/10) : les actions en haut, puis le titre hébreu dans la
        police du siddour, des étiquettes courtes (le nom traduit, le nusah) et l'horaire du
        jour de la prière. Pas d'image ici (12/10) : on ne prie pas devant une image
        (Choul'han Aroukh, Ora'h 'Haïm 90, 23).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:tag="bandeau"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Marque-pages (15/10) : la liste de ceux du texte. -->
            <ImageView
                android:id="@+id/siddur_lecture_marques"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_rond_bandeau"
                android:contentDescription="@string/marques_titre"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_marque_priere" />

            <!-- Favori (14/10) : l'étoile ajoute ou retire le texte de la liste de la Bibliothèque. -->
            <TextView
                android:id="@+id/siddur_lecture_favori"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rond_bandeau"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/siddur_lecture_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="right"
            android:textColor="@color/white"
            android:textDirection="rtl"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/siddur_lecture_etiquettes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layoutDirection="rtl"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="2dp" />

        <TextView
            android:id="@+id/siddur_lecture_horaire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="right"
            android:textColor="?attr/mhMint"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Gardé pour la lecture d'écran : les étiquettes en une phrase. -->
        <TextView
            android:id="@+id/siddur_lecture_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- La bande de signets : une section par signet, de droite à gauche comme
         le texte. Discrète exprès : petite, du ton de la page, un trait fin
         dessous ; seule la section en cours se marque. Absente d'un texte
         d'une seule section. -->
    <HorizontalScrollView
        android:id="@+id/siddur_lecture_signets_defile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layoutDirection="rtl"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/siddur_lecture_signets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </HorizontalScrollView>

    <View
        android:id="@+id/siddur_lecture_signets_trait"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Le texte ; le bouton de lecture (ReglagesLecture) se pose par-dessus tout l'écran. -->
    <FrameLayout
        android:id="@+id/siddur_lecture_cadre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/siddur_lecture_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp" />
    </FrameLayout>
</LinearLayout>
