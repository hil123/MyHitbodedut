<?xml version="1.0" encoding="utf-8"?>
<!-- La lecture d'un texte du siddour : une liste recyclée (SiddurLectureActivity). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/siddur_lecture_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/siddur_lecture_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/mhMint"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="78dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_stage"
            android:padding="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/char_praying" />
        </FrameLayout>
    </LinearLayout>

    <!-- La bande de signets : une section par signet, de droite à gauche comme
         le texte. Discrète exprès : petite, du ton de la page, un trait fin
         dessous ; seule la section en cours se marque. Absente d'un texte
         d'une seule section. -->
    <HorizontalScrollView
        android:id="@+id/siddur_lecture_signets_defile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layoutDirection="rtl"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/siddur_lecture_signets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </HorizontalScrollView>

    <View
        android:id="@+id/siddur_lecture_signets_trait"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone" />

    <!-- Le texte ; le bouton de lecture (ReglagesLecture) se pose par-dessus tout l'écran. -->
    <FrameLayout
        android:id="@+id/siddur_lecture_cadre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/siddur_lecture_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp" />
    </FrameLayout>
</LinearLayout>
