<?xml version="1.0" encoding="utf-8"?>
<!--
    La carte de la hitbodedout guidée.

    Elle sert de repère, pas de programme : un temps à la fois, et rien
    n'oblige à les parcourir tous. L'hébreu est en direction droite-à-gauche
    quelle que soit la langue de l'interface, comme sur la carte de 'hizouk.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_stage_soft"
            android:padding="4dp">

            <ImageView
                android:id="@+id/hitbodedut_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hitbodedut_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_mint"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/mhOnPlate"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hitbodedut_he"
                android:fontFamily="@font/hebreu_serif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layoutDirection="rtl"
                android:textAlignment="viewStart"
                android:textColor="?attr/mhInk"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hitbodedut_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/mhBrand"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/hitbodedut_invite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2sp"
        android:textColor="?attr/mhMuted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/hitbodedut_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layoutDirection="rtl"
        android:textAlignment="viewStart"
        android:textColor="?attr/mhMuted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hitbodedut_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/hitbodedut_previous"
            android:textColor="?attr/mhBrand"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/hitbodedut_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:text="@string/hitbodedut_next"
            android:textColor="?attr/mhBrand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
