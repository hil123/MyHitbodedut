<?xml version="1.0" encoding="utf-8"?>
<!--
    Les réglages, sortis de l'écran principal.

    Ils y occupaient la moitié de la hauteur, sous les six cartes qui
    servent tous les jours. Les autorisations surtout : on ne les cherche
    que lorsque quelque chose ne marche pas, et elles étaient tout en bas.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/wide_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edge_inner"
            android:paddingTop="@dimen/hero_pad_top"
            android:paddingBottom="@dimen/hero_pad_bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="@string/settings_title"
                android:textColor="?attr/mhMint"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/white"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Diagnostic de la barrière : pourquoi elle agit, ou pourquoi non -->
        <!--
            La langue, en tête : le propriétaire a cherché ce bouton et ne
            l'a pas trouvé. Il était plus bas que l'écran, entre deux
            réglages. Une fonction qu'on ne trouve pas n'existe pas.
        -->
        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">

                <TextView style="@style/SettingLabel" android:text="@string/settings_language" />

                <Button android:id="@+id/language_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_adresse" />

                <Button android:id="@+id/adresse_button" style="@style/SettingValue" />
            </LinearLayout>

            <Button
                android:id="@+id/onboarding_again"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_onboarding" />
        </LinearLayout>

        <!-- Les couleurs, juste sous la langue : ce sont les deux réglages qu'on cherche en premier. -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_appearance" />

            <TextView style="@style/CardHint" android:text="@string/section_appearance_hint" />

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_mode" />

                <Button android:id="@+id/mode_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_fond" />

                <Button android:id="@+id/fond_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_accent" />

                <Button android:id="@+id/accent_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_police" />

                <Button android:id="@+id/police_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_ouverture" />

                <Button android:id="@+id/ouverture_button" style="@style/SettingValue" />
            </LinearLayout>
        </LinearLayout>

        <!-- L'écran Zmanim (14/10) : ce qui s'affiche sous les horaires, et le livre de la halakha. -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_zmanim_ecran" />

            <TextView style="@style/CardHint" android:text="@string/section_zmanim_ecran_hint" />

            <LinearLayout style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/reglage_levana" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/levana_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/levana_usage_titre" />

                <Button android:id="@+id/levana_usage_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/hilloulot_afficher" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hilloulot_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView
                    style="@style/SettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/halakha_afficher" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/halakha_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/halakha_source_titre" />

                <Button android:id="@+id/halakha_source_button" style="@style/SettingValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/card_gate_state" style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_gate_state" />

            <TextView
                android:id="@+id/gate_state_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gate_state_detail"
                style="@style/CardHint"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />

            <!-- Visible seulement quand une autorisation manque : mène à la carte. -->
            <Button
                android:id="@+id/gate_fix_permissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/gate_permissions_action"
                android:visibility="gone" />

            <Button
                android:id="@+id/preview_gate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/action_preview_gate" />
        </LinearLayout>

        <!-- Réglages de la barrière -->
        <LinearLayout android:id="@+id/card_gate_settings" style="@style/Card">

            <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/section_gate" />

                    <TextView style="@style/CardHint" android:text="@string/section_gate_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/enable_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">

                <TextView style="@style/SettingLabel" android:text="@string/settings_window" />

                <Button
                    android:id="@+id/window_start"
                    style="@style/SettingValue" />

                <Button
                    android:id="@+id/window_end"
                    style="@style/SettingValue"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_snooze" />

                <Button android:id="@+id/snooze_length" style="@style/SettingValue" />
            </LinearLayout>

            <View style="@style/Divider" />

            <TextView
                android:id="@+id/apps_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp" />

            <Button
                android:id="@+id/pick_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/action_pick_apps" />
        </LinearLayout>

        <!-- Rythme de la pratique -->
        <LinearLayout style="@style/Card">


            <TextView style="@style/CardTitle" android:text="@string/section_rhythm" />

            <LinearLayout style="@style/SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_name" />

                    <TextView style="@style/CardHint" android:text="@string/settings_name_hint" />
                </LinearLayout>

                <Button android:id="@+id/name_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_target" />

                <Button android:id="@+id/target_length" style="@style/SettingValue" />
            </LinearLayout>

            <View style="@style/Divider" />

            <!-- L'objectif de l'anneau du jour. Vide, il vaut la durée ci-dessus. -->
            <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_daily_goal" />

                    <TextView style="@style/CardHint" android:text="@string/settings_daily_goal_hint" />
                </LinearLayout>

                <Button android:id="@+id/daily_goal" style="@style/SettingValue" />
            </LinearLayout>

            <View style="@style/Divider" />

            <LinearLayout style="@style/SettingRow" android:layout_marginTop="0dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_shabbat" />

                    <TextView style="@style/CardHint" android:text="@string/settings_shabbat_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/shabbat_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <TextView style="@style/SettingLabel" android:text="@string/settings_region" />

                <Button android:id="@+id/region_button" style="@style/SettingValue" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_hide_countdown" />

                    <TextView style="@style/CardHint" android:text="@string/settings_hide_countdown_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/hide_countdown_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_hitbodedut" />

                    <TextView style="@style/CardHint" android:text="@string/settings_hitbodedut_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/guided_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SettingLabelStacked" android:text="@string/settings_exempt_today" />

                    <TextView style="@style/CardHint" android:text="@string/settings_exempt_today_hint" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/exempt_today_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Point 4 : le moment « lieu », dans les réglages de lieu et de moment. -->
            <include
                android:id="@+id/lieu_chizuk"
                layout="@layout/view_chizuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- Autorisations -->
        <LinearLayout android:id="@+id/card_permissions" style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_permissions" />

            <TextView style="@style/CardHint" android:text="@string/section_permissions_hint" />

            <!--
                Les lignes sont posées par le code, une par autorisation que
                cette édition demande : l'édition légère n'a pas de barrière,
                donc pas les deux autorisations qui vont avec.
            -->
            <LinearLayout
                android:id="@+id/permission_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Sauvegarde -->
        <LinearLayout style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/section_data" />

            <TextView style="@style/CardHint" android:text="@string/section_data_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/export_data"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_export" />

                <Button
                    android:id="@+id/import_data"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/action_import" />
            </LinearLayout>
        </LinearLayout>

        <!-- Réinitialiser l'application (12/10) : en dernier, à l'écart, avec une confirmation. -->
        <LinearLayout android:id="@+id/card_reset" style="@style/Card">

            <TextView style="@style/CardTitle" android:text="@string/reset_title" />

            <TextView style="@style/CardHint" android:text="@string/reset_hint" />

            <Button
                android:id="@+id/reset_app"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/danger"
                android:text="@string/reset_action" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAlignment="center"
            android:textColor="?attr/mhMint"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
