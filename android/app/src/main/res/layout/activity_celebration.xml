<?xml version="1.0" encoding="utf-8"?>
<!--
    Le bravo de fin de séance. Il défile, comme les autres écrans : en
    paysage sur un petit téléphone, il ne reste que 320dp de haut.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/edge"
        android:paddingVertical="22dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stage"
            android:minHeight="200dp"
            android:padding="14dp">

            <ImageView
                android:id="@+id/celebration_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/char_dancing" />
        </FrameLayout>

        <TextView
            android:id="@+id/celebration_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="?attr/mhInk"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/celebration_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="?attr/mhMuted"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/celebration_ask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/celebration_ask"
                android:textColor="?attr/mhMuted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/celebration_tsadik"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/adresse_tsadik" />

                <Button
                    android:id="@+id/celebration_tsadeket"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/adresse_tsadeket" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/celebration_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingVertical="14dp"
            android:text="@string/celebration_continue"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
