<?xml version="1.0" encoding="utf-8"?>
<!--
    Le bravo de fin de séance. Il défile, comme les autres écrans : en
    paysage sur un petit téléphone, il ne reste que 320dp de haut.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/edge"
        android:paddingVertical="22dp">

        <!--
            La scène. Le danseur porte deux poses superposées, jambe droite
            puis jambe gauche levée, que la danse alterne à chaque saut ; les
            notes qui montent sont ajoutées à la scène par le code. La marge
            du haut laisse la place du saut.
        -->
        <FrameLayout
            android:id="@+id/celebration_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stage"
            android:minHeight="200dp"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/celebration_dancer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="18dp">

                <ImageView
                    android:id="@+id/celebration_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/char_dancing" />

                <ImageView
                    android:id="@+id/celebration_art_b"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/char_dancing_joy" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/celebration_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:textColor="?attr/mhInk"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/celebration_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="?attr/mhMuted"
            android:textSize="16sp" />

        <!-- Après une séance annulée seulement : un mot du moment « relance ». -->
        <include
            android:id="@+id/celebration_chizuk"
            layout="@layout/view_chizuk_compact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/celebration_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingVertical="14dp"
            android:text="@string/celebration_continue"
            android:textSize="16sp" />

        <!-- Partager la séance faite (12/10), avec le lien de la version web. -->
        <Button
            android:id="@+id/celebration_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/partage_action"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
