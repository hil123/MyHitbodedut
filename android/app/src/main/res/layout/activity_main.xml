<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/wide_gutter">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Bandeau : où j'en suis aujourd'hui -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/edge"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/mint"
                android:textSize="13sp"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/status_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/status_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- La séance -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="@dimen/art_height_small"
                    android:background="@drawable/bg_stage_soft"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/hero_character"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/CardTitle" android:text="@string/section_practice" />

                    <TextView
                        android:id="@+id/today_detail"
                        style="@style/CardHint"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/week_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />

            <!-- Point 4 : le moment « relance », après une rupture de série. -->
            <include
                android:id="@+id/relance_chizuk"
                layout="@layout/view_chizuk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <Button
                android:id="@+id/start_session"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingVertical="17dp"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/today_note"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_write_note"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/open_journal"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_journal" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Tout le reste, en lignes plutôt qu'en cartes.

            Chacune de ces six entrées était une carte pleine, et il fallait
            traverser trois écrans avant d'avoir tout vu. Rien n'est retiré :
            les états que les cartes affichaient — l'heure des rappels, les
            psaumes déjà dits, le morceau choisi, les autorisations qui
            manquent — sont toujours là, sur la deuxième ligne de chaque
            entrée. C'est la place qu'ils prenaient qui change.
        -->
        <LinearLayout style="@style/Card">

        <LinearLayout
            android:id="@+id/tikkun_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/tikkun_title_he" />

                <TextView
                    android:id="@+id/tikkun_state"
                    style="@style/SectionState" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/library_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/library_title" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/reminders_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/reminders_title" />

                <TextView
                    android:id="@+id/reminders_state"
                    style="@style/SectionState" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/music_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/music_title" />

                <TextView
                    android:id="@+id/music_state"
                    style="@style/SectionState" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/music_switch_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tips_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/tips_title" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/settings_button"
            style="@style/SectionRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/settings_title" />

                <TextView
                    android:id="@+id/settings_state"
                    style="@style/SectionState" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/proofread_button"
            style="@style/SectionRow"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingLabelStacked"
                    android:text="@string/proofread_open" />
            </LinearLayout>

            <ImageView style="@style/SectionChevron" />
        </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
