    <!-- Tips for Hitbodedut -->
    <string name="tips_title">עצות להתבודדות</string>
    <string name="tips_hint">עשר נקודות, להתחלה ולהתמדה.</string>
    <string name="tips_open">לקריאת העצות</string>
    <string name="tip_1_title">בחרו מקום שקט ונפרד</string>
    <string name="tip_1_body">השלב הראשון בהתבודדות הוא למצוא מקום שקט, שבו תוכלו להיות לבד עם עצמכם ועם השם. המקום לא חייב להיות מבודד לחלוטין, אך הוא צריך להיות מקום שבו אתם לא תופרעו. זה יכול להיות חדר פנוי בבית, חוף ים שקט, או מקום בטבע. אם אתם יכולים, מומלץ לבחור מקום טבעי, שכן הטבע עצמו עשוי להיות מקור לשקט פנימי.</string>
    <string name="tip_2_title">קבעו זמן יומי או שבועי להתבודדות</string>
    <string name="tip_2_body">התחילו בזמן קצר בהתחלה, אם אתם חדשים בזה. הקדישו חמש-עשרה דקות ביום להתבודדות, והגבירו את הזמן בהדרגה עד שתגיעו לשעה שלמה. חשוב לא לקפוץ מיד לזמן ארוך מדי, אלא להתחיל צעד-צעד, כך שההתבודדות תהפוך להרגל ולא לנטל. קבעו זמן קבוע שבו אתם מתבודדים, כך שהתהליך יהפוך לחלק מהשגרה שלכם ולא לפעולה אקראית.</string>
    <string name="tip_3_title">תתחילו בדיבור פנימי</string>
    <string name="tip_3_body">התחילו את ההתבודדות בדיבור פנימי, דברו עם השם. אל תדאגו אם בהתחלה לא תדעו בדיוק מה לומר. פשוט פתחו את הלב והתחילו לשוחח. זה יכול להיות בקשת סליחה, תפילה פשוטה על מה שאתם מרגישים, או אפילו תחושות של תודה. ההתבודדות לא צריכה להיות מסודרת או מתוכננת מראש, היא מקום שבו אתם יכולים לשחרר את מה שיש בליבכם ולהתמקד בקשר עם השם.</string>
    <string name="tip_4_title">הימנעו ממכשירים טכנולוגיים</string>
    <string name="tip_4_body">אם אתם רוצים להרגיש באמת לבד עם עצמכם, חשוב להימנע לחלוטין מהמכשירים הטכנולוגיים במהלך ההתבודדות. כבו את הטלפון הנייד או הניחו אותו בחדר אחר. ככל שתהיו יותר פנויים מהסחות דעת חיצוניות, כך תצליחו להתחבר בצורה טובה יותר לעצמכם ולבורא עולם. ניתוק מהעולם החיצוני עוזר להתרכז ולהתמקד בשקט הפנימי.</string>
    <string name="tip_5_title">התחילו עם ספר תהילים או תפילה אישית</string>
    <string name="tip_5_body">אם אתם לא בטוחים איך להתחיל, אפשר לפתוח בספר תהילים ולקרוא כמה פרקים. תהילים הם תפילה מחוברת, מאוד ישירה ונוגעת בנפש. כשאתם מתבודדים, תהילים יכולים להוות חוט מקשר רוחני שמחבר אתכם ישירות אל השם. אם אתם מרגישים חסרי מילים, אתם יכולים גם פשוט לדבר עם השם באופן חופשי, לשתף אותו במחשבות ובתחושות שלכם.</string>
    <string name="tip_6_title">שאלו את עצמכם שאלות פנימיות</string>
    <string name="tip_6_body">במהלך ההתבודדות, שאלו את עצמכם שאלות פנימיות: מה אני מרגיש עכשיו? מה עובר עליי? איך אני יכול להרגיש קרוב יותר אל השם? מה אני צריך לשפר בחיי? זהו זמן לחשבון נפש אמיתי. לפעמים, בשקט הפנימי, אתם יכולים להבין את הצרכים האמיתיים שלכם ולהתחיל להבין את הכיוונים הנכונים לחיים שלכם.</string>
    <string name="tip_7_title">שימו דגש על כנות פנימית</string>
    <string name="tip_7_body">במהלך ההתבודדות, אל תנסו להסתיר מהשם את מה שאתם מרגישים. ההתבודדות היא זמן שבו מותר לכם להיות כנים עם עצמכם ועם בורא עולם. אם אתם מרגישים כעס, תסכול, פחד או חוסר ביטחון, זהו המקום לשתף את תחושותיכם. הכנות היא המפתח להתפתחות רוחנית. ככל שתהיו יותר כנים, כך תחוו יותר שקט פנימי.</string>
    <string name="tip_8_title">הפכו את ההתבודדות לרגע של התפייסות עם עצמכם</string>
    <string name="tip_8_body">ההתבודדות יכולה גם להיות זמן שבו אתם מתפייסים עם עצמכם. הכוונה היא להיות במקום שבו אתם לא שיפוטיים, לא ביקורתיים ולא נזעמים על עצמכם. זהו זמן של פיוס, שבו אתם סולחים לעצמכם ומבקשים סליחה על טעויות, ומתכוונים לשפר את הדרך.</string>
    <string name="tip_9_title">הוסיפו זמן לשקט או התרכזו בנשימות</string>
    <string name="tip_9_body">חלק מההתבודדות יכולה להיות שקט מוחלט, או רגע של התרכזות בנשימות. ניתן לשבת בשקט למשך זמן מסוים, להתרכז בנשימות ולהתמקד בתחושות הגוף. השקט הזה מאפשר לחלקים הפנימיים שלכם להתגלות ולהתבהר.</string>
    <string name="tip_10_title">סיימו בנשימה עמוקה והודיה</string>
    <string name="tip_10_body">בסיומה של ההתבודדות, חשוב לסיים בנשימה עמוקה ולברך את השם על הזמן שביליתם עמו. זהו זמן של הודיה על המתנה הגדולה של החיבור עם רוחניות, ועל השקט הפנימי שהושג. גם אם הרגשתם שקשה למצוא תשובות, אל תדאגו, המפגש הזה עם עצמכם ועם השם עצמו כבר מביא שפע רוחני בחיים.</string>

