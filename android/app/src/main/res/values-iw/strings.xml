    <string name="onboarding_session">ההתבודדות</string>
    <string name="onboarding_session_body">בוחרים משך, או התבודדות בלי הגבלת זמן, ואם רוצים גם נושא. ניגון יכול ללוות אתכם. מילת חיזוק פותחת וסוגרת את ההתבודדות, ואם המילים לא באות, יש כפתור שעוזר.</string>
    <string name="onboarding_days">יום אחרי יום</string>
    <string name="onboarding_days_body">הרצף סופר את הימים ברציפות, והשבוע כולו נראה במבט אחד. אחרי כל התבודדות אפשר להשאיר הערה ביומן. תזכורות מאותתות בשעה שבוחרים.</string>
