<?xml version="1.0" encoding="utf-8"?>
<!-- Les vignettes des zmanim (28/10) : une nuit verte profonde, filet clair, coins 24dp.
     Lisible sur tout fond d'écran, sans dépendre du thème. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0D2422" android:centerColor="#FF12302D" android:endColor="#FF1B4640" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
