<?xml version="1.0" encoding="utf-8"?>
<!--
    Le fond de la vignette tel que le montre l'aperçu du sélecteur (qui la
    dessine sans le code) : le dégradé de la palette verte d'origine, du
    vert des jours faits vers le vert foncé. Sur l'écran d'accueil, le code
    le remplace par une image au dégradé de la palette choisie, avec ses
    arcs et son halo (StreakWidget.fond, VignetteDecor).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/brand_dark"
        android:startColor="@color/day_done"
        android:type="linear" />
    <corners android:radius="22dp" />
</shape>
