<?xml version="1.0" encoding="utf-8"?>
<!--
    Les anneaux et le hassid tels que les montre l'aperçu du sélecteur de
    vignettes, qui la dessine sans le code. Sur l'écran d'accueil, le code
    les remplace par l'image des vrais anneaux (StreakWidget.jauge).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Un carré : sans lui, la taille propre de l'image serait celle du hassid, et les anneaux s'ovaliseraient. -->
    <item
        android:width="110dp"
        android:height="110dp">
        <shape android:shape="oval">
            <solid android:color="#29000000" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="@color/ring_streak_on_dark" />
        </shape>
    </item>
    <item
        android:bottom="13.5dp"
        android:left="13.5dp"
        android:right="13.5dp"
        android:top="13.5dp">
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="@color/ring_week_on_dark" />
        </shape>
    </item>
    <item
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp"
        android:top="22dp">
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="@color/mint" />
        </shape>
    </item>
    <item
        android:bottom="31dp"
        android:left="31dp"
        android:right="31dp"
        android:top="31dp">
        <shape android:shape="oval">
            <solid android:color="@color/stage_soft" />
        </shape>
    </item>
    <item
        android:width="27dp"
        android:height="38dp"
        android:drawable="@drawable/char_welcome"
        android:gravity="center" />
</layer-list>
