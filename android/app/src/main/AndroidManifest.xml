<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Tient le processeur éveillé jusqu'au terme d'une séance minutée (SessionService). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Les zmanim (10/10) : la position approximative, seulement si on choisit
         « Ma position » plutôt qu'une ville, et demandée à ce moment-là. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Aucun accès à Internet (choix du propriétaire, 11/10) : hilloulot, halakha
         du jour, siddour et zmanim sont embarqués ; les liens s'ouvrent dans le
         navigateur. Retirée même si une bibliothèque la demandait. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!--
        Sans cette ligne, Android considere l'ecran tactile comme requis et
        Google Play retire l'application des Chromebooks qui n'en ont pas.
        Rien ici ne demande un doigt : tout se fait aussi a la souris et au
        clavier.
    -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        resizeableActivity : c'est deja le defaut, mais il decide de l'ecran
        partage, de la fenetre libre et du bureau — il est donc ecrit plutot
        que subi.
    -->
    <application
        android:name=".MyHitbodedutApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyHitbodedut">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                La fenetre au lancement sur un bureau ou en fenetre libre.
                Sans cela, l'application s'ouvre a la taille que le systeme
                juge bonne, souvent tres large, et chaque ligne de texte
                traverse l'ecran. Le minimum reprend le plancher d'Android.
            -->
            <layout
                android:defaultHeight="760dp"
                android:defaultWidth="420dp"
                android:gravity="center"
                android:minHeight="320dp"
                android:minWidth="320dp" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name" />
        <activity
            android:name=".CelebrationActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:label="@string/app_name" />

        <activity
            android:name=".SessionActivity"
            android:exported="false"
            android:label="@string/session_screen_title"
            android:launchMode="singleTop" />

        <activity
            android:name=".JournalActivity"
            android:exported="false"
            android:label="@string/journal_title" />

        <activity
            android:name=".TipsActivity"
            android:exported="false"
            android:label="@string/tips_title" />

        <activity
            android:name=".RemindersActivity"
            android:exported="false"
            android:label="@string/reminders_title" />

        <activity
            android:name=".TikkunActivity"
            android:exported="false"
            android:label="@string/tikkun_title" />

        <activity
            android:name=".LiturgyActivity"
            android:exported="false"
            android:label="@string/tikkun_title" />

        <activity
            android:name=".TikkunFlowActivity"
            android:exported="false"
            android:label="@string/tikkun_title" />

        <activity
            android:name=".SiddurActivity"
            android:exported="false"
            android:label="@string/siddur_title" />

        <activity
            android:name=".SiddurLectureActivity"
            android:exported="false"
            android:label="@string/siddur_title" />

        <activity
            android:name=".TehilimActivity"
            android:exported="false"
            android:label="@string/tehilim_title" />

        <activity
            android:name=".TehilimLectureActivity"
            android:exported="false"
            android:label="@string/tehilim_title" />

        <activity
            android:name=".PsalmActivity"
            android:exported="false"
            android:label="@string/tikkun_title" />

        <activity
            android:name=".TefilotActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LibraryActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <activity
            android:name=".LibrarySubSectionActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <activity
            android:name=".LibraryEntryActivity"
            android:exported="false"
            android:label="@string/library_title" />

        <!-- Écran de relecture. Déclaré ici pour que MainActivity puisse le
             nommer, mais rien n'y mène hors compilation de test : le bouton
             qui l'ouvre est masqué quand BuildConfig.DEBUG est faux. -->
        <activity
            android:name=".ProofreadActivity"
            android:exported="false"
            android:label="@string/proofread_title" />

        <activity
            android:name=".ZmanimActivity"
            android:exported="false"
            android:label="@string/zmanim_title" />

        <activity
            android:name=".CalendrierActivity"
            android:exported="false"
            android:label="@string/calendrier_title" />

        <activity
            android:name=".HilloulotActivity"
            android:exported="false"
            android:label="@string/hilloulot_title" />

        <activity
            android:name=".HalakhaActivity"
            android:exported="false"
            android:label="@string/halakha_title" />

        <activity
            android:name=".PaliersActivity"
            android:exported="false"
            android:label="@string/trophees_paliers_titre" />

        <activity
            android:name=".MusicActivity"
            android:exported="false"
            android:label="@string/music_title" />

        <!-- La séance décompte le temps et peut jouer un morceau : les deux
             types sont déclarés, comme Android l'exige depuis la version 14. -->
        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FOREGROUND_SERVICE_SUBTYPE"
                android:value="Runs the countdown of a user-started meditation session and shows the remaining time, so the phone can be put down." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- La série sur l'écran d'accueil. -->
        <receiver
            android:name=".StreakWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_streak_info" />
        </receiver>

        <!--
            Sous Android 13, c'est le systeme qui retient la langue choisie.
            En dessous, c'est AppCompat, et il ne le fait que si ce service
            est declare : sans lui, le choix serait oublie a la fermeture.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
